# Django Settings
DEBUG=True
SECRET_KEY=django-insecure-your-secret-key-change-in-production

# Database - PostgreSQL (default)
# To use MySQL instead, change to: mysql://financial_user:financial_password@db:3306/financial_db
DATABASE_URL=postgres://financial_user:financial_password@db:5432/financial_db
DB_PASSWORD=financial_password

# Redis
REDIS_PASSWORD=redis_password
REDIS_URL=redis://:redis_password@redis:6379/0

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001
FRONTEND_URL=http://localhost:3001

# Allowed Hosts
ALLOWED_HOSTS=localhost,127.0.0.1,financial-backend,frontend,nginx

# Keycloak federation API. Generate with `openssl rand -hex 32` and set the
# same value as FINANCIAL_INTERNAL_IDP_API_KEY in ~/Projects/SSO/.env.
# Never commit the real value.
FINANCIAL_INTERNAL_IDP_API_KEY=CHANGE_ME_shared_financial_idp_key

# Remaining DMS mapper / launcher probe secret. Separate from the financial key.
# Must match DMS_INTERNAL_IDP_API_KEY in ~/Projects/SSO/.env and ~/Projects/IDM/.env.
DMS_INTERNAL_IDP_API_KEY=CHANGE_ME_shared_dms_idp_key
DMS_INTERNAL_API_BASE_URL=http://backend:8000/api/v1/internal/idp
DMS_PUBLIC_URL=http://localhost:3000

# Split-horizon Keycloak (browser localhost:8080, containers keycloak:8080)
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_INTERNAL_URL=http://keycloak:8080
KEYCLOAK_REALM=idp-dev
OIDC_CLIENT_ID=financial-client
OIDC_OP_ISSUER=http://localhost:8080/realms/idp-dev
OIDC_OP_JWKS_ENDPOINT=http://keycloak:8080/realms/idp-dev/protocol/openid-connect/certs

# Auth Mode - Controls which authentication method the login page displays:
#   keycloak  — Show only "Sign in with Keycloak" button (IdP-connected deployments)
#   native    — Show native username/password form (standalone on-prem deployments)
# This is a deployment-time configuration, not a runtime user toggle.
AUTH_MODE=native

# Email (optional)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=financial@example.com
